{
  "name": "image-to-binary-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run wasm:build",
    "build": "tsc -b && vite build",
    "prebuild": "npm run wasm:build",
    "typecheck": "tsc -b",
    "pretypecheck": "npm run wasm:build",
    "wasm:build": "node ../crates/wasm/scripts/build.mjs",
    "test": "vitest run",
    "format": "prettier --write src tsconfig*.json vite.config.ts package.json .prettierrc.json",
    "format:check": "prettier --check src tsconfig*.json vite.config.ts package.json .prettierrc.json"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "prettier": "3.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
