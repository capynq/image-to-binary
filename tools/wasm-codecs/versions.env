# Pinned Emscripten SDK for the browser HEIC/AVIF decoder build.
# Native codec pins (libheif, libde265, libaom and their SHA-256 hashes) are
# shared from tools/native-codecs/versions.env; build.sh sources both files.
#
# EMSDK_COMMIT is the commit the EMSDK_VERSION tag resolves to; build.sh refuses
# a checkout whose HEAD differs.

EMSDK_VERSION=6.0.13
EMSDK_REPO=https://github.com/emscripten-core/emsdk.git
EMSDK_COMMIT=35659964bc2762fffec0d257997fb61475f765b7
